@startuml


  [Arduino/EspressIF framework]
  [CRC]
  [ArduinoMqttClient]
  [ArduinoJSON]
  [spin-timer]
  [Shell]
  [debug]



folder "model" as MODEL {
  [WIFI settings]
  [MQTT settings]
  [settings]
}

folder "controller" as CONTROLLER {
  [WIFI controller]
  [MQTT controller]
  [controllerFacade]
  [WIFI action]
  [MQTT action]
}

folder "view" as VIEW {
  [Shell cmds]
  [viewFacade]
}


main -up-> [controllerFacade]


[controllerFacade] --> [settings]
[controllerFacade] --> [viewFacade]


[settings] -up-> [WIFI settings]
[settings] -up-> [MQTT settings]

[settings] -up-> [CRC]
[settings] -up-> [Arduino/EspressIF framework]


[controllerFacade] -up-> [WIFI controller]
[controllerFacade] -up-> [MQTT controller]
[controllerFacade] <-up-> [WIFI action]
[controllerFacade] <-up-> [MQTT action]

[WIFI controller] -up-> [Arduino/EspressIF framework]
[WIFI action] -up-> [spin-timer]

[MQTT controller] -up-> [ArduinoMqttClient]
[MQTT controller] -up-> [Arduino/EspressIF framework]
[MQTT action] -up-> [spin-timer]
[MQTT action] -up-> [ArduinoJSON]


[viewFacade] -up-> [Shell cmds]
[viewFacade] -up-> [Shell]


@enduml